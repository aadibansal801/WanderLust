<% if(success && success.length){ %>
    <div class="alert alert-success mt-3 alert-dismissable fade show col-6 offset-3 d-flex align-items-center" role="alert">
        <%= success %>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert alert-danger mt-3 alert-dismissable fade show col-6 offset-3 d-flex align-items-center" role="alert">
        <%= error %>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>