<style>
  .btn-search{
    background-color: #fe424d;
    color: white;
    border-radius: 999px;

  }
  .btn-search:hover{
    background-color: #fe424d;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
    color: white;
  }
  .search-bar{
    border: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
    border-radius: 100px;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form
    role="search"
    class="d-flex"
    method="GET"
    action="/listings"
>
    <input
        type="search"
        class="form-control me-2 search-bar"
        placeholder="Search Destination"
        aria-label="Search"
        name="search"
    >

    <button class="btn btn-search" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</form>
      </div>
      <div class="navbar-nav ms-auto"> 

    <a class="nav-link" href="/listings/new">
        Airbnb your home
    </a> 
    <% if(!currUser){ %> 
        <a
            class="nav-link"
            href="#"
            data-bs-toggle="modal"
            data-bs-target="#signupModal"
        >
            <b>Sign Up</b>
        </a>
        <a
            class="nav-link"
            href="#"
            data-bs-toggle="modal"
            data-bs-target="#loginModal"
        >
            <b>Log in</b>
        </a>
    <% } %> 
    <% if(currUser){ %> 
        <a class="nav-link" href="/logout">
            <b>Log out</b>
        </a>
    <% } %> 
</div>
    </div>
  </div>
</nav>

<!-- SIGNUP MODAL -->
<div
    class="modal fade"
    id="signupModal"
    tabindex="-1"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Sign up on WanderLust
                </h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>
            </div>
            <div class="modal-body">
                <form id="signupForm">
                    <div class="mb-3">
                        <label class="form-label">
                            Username
                        </label>

                        <input
                            type="text"
                            name="username"
                            class="form-control"
                            required
                        >
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Email
                        </label>
                        <input
                            type="email"
                            name="email"
                            class="form-control"
                            required
                        >
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            class="form-control"
                            required
                        >
                    </div>
                    <div
                        id="signupError"
                        class="alert alert-danger d-none"
                    ></div>
                    <button
                        type="submit"
                        class="btn btn-danger w-100"
                    >
                        Sign Up
                    </button>
                    <div class="text-center my-3">
                      <span>OR</span>
                    </div>

                    <a href="/auth/google" class="btn btn-outline-dark w-100">
                      <i class="fa-brands fa-google me-2"></i>
                      Continue with Google
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- LOGIN MODAL -->
<div
    class="modal fade"
    id="loginModal"
    tabindex="-1"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Log in to WanderLust
                </h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>
            </div>
            <div class="modal-body">
                <form id="loginForm">
                    <div class="mb-3">
                        <label class="form-label">
                            Username
                        </label>
                        <input
                            type="text"
                            name="username"
                            class="form-control"
                            required
                        >
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Password
                        </label>
                        <input
                            type="password"
                            name="password"
                            class="form-control"
                            required
                        >
                    </div>
                    <div
                        id="loginError"
                        class="alert alert-danger d-none"
                    ></div>
                    <button
                        type="submit"
                        class="btn btn-danger w-100"
                    >
                        Log In
                    </button>
                    <div class="text-center my-3">
                      <span>OR</span>
                    </div>
                    <a href="/auth/google" class="btn btn-outline-dark w-100">
                        <i class="fa-brands fa-google me-2"></i>
                        Continue with Google
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
