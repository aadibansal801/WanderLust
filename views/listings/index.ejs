<% layout("/layouts/boilerplate.ejs") %>

    <style>
        #filters {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 90%;
    max-width: 1000px;

    margin: 1.5rem auto 2rem;
    padding: 0.8rem 1.5rem;

    gap: 1.8rem;

    background-color: white;
    border-radius: 50px;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);

    overflow-x: auto;
    scrollbar-width: none;
}

#filters::-webkit-scrollbar {
    display: none;
}

.filter {
    flex: 0 0 auto;

    display: flex;
    flex-direction: column;
    align-items: center;

    min-width: 55px;

    margin: 0;

    color: #222;
    text-decoration: none;

    opacity: 0.65;
}

.filter:hover {
    opacity: 1;
    transform: translateY(-2px);
}

.filter i {
    font-size: 1rem;
    margin-bottom: 0.35rem;
}

.filter p {
    margin: 0;
    font-size: 0.75rem;
    white-space: nowrap;
}


/* =========================
   TABLET
   ========================= */

@media (max-width: 900px) {

    #filters {
        width: 92%;
        max-width: none;

        justify-content: flex-start;

        gap: 1.4rem;

        padding: 0.7rem 1.2rem;
    }
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 600px) {

    #filters {
        width: calc(100% - 30px);
        max-width: none;

        margin: 1rem 15px;

        padding: 0.65rem 1rem;

        justify-content: flex-start;

        gap: 1.2rem;

        border-radius: 40px;

        overflow-x: scroll;

        -webkit-overflow-scrolling: touch;
    }

    .filter {
        flex: 0 0 50px;
        min-width: 50px;
    }

    .filter i {
        font-size: 0.9rem;
    }

    .filter p {
        font-size: 0.65rem;
    }
}
    </style>

     <div id="filters">
        <div class="filter">
            <a href="/listings?category=Trending" class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Rooms" class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Iconic%20Cities" class="filter">
            <div><i class="fa-sharp fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Mountains" class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Castles" class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Amazing%20Pools" class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Camping" class="filter">
            <div><i class="fa-solid fa-tent"></i></div>
            <p>Camping</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Farms" class="filter">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
            </a>
        </div>
        <div class="filter">
            <a href="/listings?category=Arctic" class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
            </a>
        </div>
     </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <%for(let listing of allListings){%>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="listing-card col card">
                    <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%=listing.title%></b> <br>
                            &#8377 <span class="listing-price" data-price = "<%=listing.price%>"><%=listing.price.toLocaleString("en-IN")%></span> /night
                        </p>
                    </div>
                </div>
            </a>
        <%}%>
    </div>


