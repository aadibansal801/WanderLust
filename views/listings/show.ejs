<% layout("/layouts/boilerplate.ejs") %>
<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3>Listing Details</h3>
    </div>
    <div class="card col-6 offset-3 show-card">
        <img src="<%=oneListing.image.url%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                <b><%=oneListing.title%></b> <br>
                <%=oneListing.description%> <br>
                &#8377 <%=oneListing.price.toLocaleString("en-IN")%> <br>
                <%=oneListing.location%> <br>
                <%=oneListing.country%> <br>
            </p>
        </div>
    </div>
    <div class="btns">
        <a href="/listings/<%=oneListing._id%>/edit" class="btn btn-dark col-1 offset-3 add-btn">Edit</a>
        <form method="post" action="/listings/<%=oneListing._id%>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
</div>


    

